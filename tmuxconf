# remap prefix to Ctrl+a
set -g prefix C-a
unbind C-b
bind C-a send-prefix

# force a reload of the config file
unbind r
bind r source-file ~/.tmux.conf

# quick pane cycling
unbind ^A
bind ^A select-pane -t :.+

# mouse actions
set -g mouse on
bind -n WheelUpPane if-shell -F -t = "#{mouse_any_flag}" "send-keys -M" "if -Ft= '#{pane_in_mode}' 'send-keys -M' 'copy-mode -e'"

# smart pane switching with awareness of vim
bind -n C-h run "(tmux display-message -p '#{pane_current_command}' | grep -iq vim && tmux send-keys C-h) || tmux select-pane -L"
bind -n C-j run "(tmux display-message -p '#{pane_current_command}' | grep -iq vim && tmux send-keys C-j) || tmux select-pane -D"
bind -n C-k run "(tmux display-message -p '#{pane_current_command}' | grep -iq vim && tmux send-keys C-k) || tmux select-pane -U"
bind -n C-l run "(tmux display-message -p '#{pane_current_command}' | grep -iq vim && tmux send-keys C-l) || tmux select-pane -R"

# Use vim keybindings
setw -g mode-keys vi

# Update default binding of 'Enter' to also use copy-pipe
unbind -T copy-mode-vi Enter
bind-key -T copy-mode-vi Enter send -X copy-pipe-and-cancel "xclip -in -selection clipboard"

# Up update frequency
set -g status-interval 1

# Theming
set -g status-style "bg=#103640"
# Set 24-hour clock
set-window-option -g clock-mode-style 24
set -g status-left-length 30
set -g status-right-length 150
# The first segment is a script from ~/.tmux/scripts that is listed in
# ~/.tmux/approved_scripts. Pick a different one with
#   TMUX_STATUS_SCRIPT=claude_input tmux                (when starting the server)
#   tmux setenv -g TMUX_STATUS_SCRIPT claude_input      (while it is running)
# The session's tags from session_tags (see session_tags.sh), in their colours,
# come first.
set -g status-right "#{?@tags,#[bold]#{@tags}#[default] #[fg=red]::#[default] ,}#(~/.tmux/status.sh current_track) #[fg=red]::#[fg=brightblue] #[bold]%d#[nobold] %b #[fg=red]:: #[fg=brightblue]%k.%M "
# Window tabs show Claude state from claude_hook.sh: red when a Claude in the
# window is blocked on you, yellow when one finished and you haven't looked,
# and a … after the name while one is working, each followed by how long it has
# been in that state. A +N means N background subagents are still running after
# Claude finished its turn; it wakes itself when they finish. Switching to a
# window marks it seen.
# @claude_age is the time since a pane's @claude_since, e.g. " 42s", " 12m", " 2h"
set -g @claude_age "#{?@claude_since, #{?#{e|<:#{e|-:%s,#{@claude_since}},60},#{e|-:%s,#{@claude_since}}s,#{?#{e|<:#{e|-:%s,#{@claude_since}},3600},#{e|/:#{e|-:%s,#{@claude_since}},60}m,#{e|/:#{e|-:%s,#{@claude_since}},3600}h}},}"
set -g window-status-format "#{?#{P:#{?#{==:#{@claude_waiting},input},1,}},#[fg=red]#[bold],#{?#{P:#{?#{==:#{@claude_waiting},done},1,}},#[fg=yellow],}}#I:#W#{?#{P:#{?#{==:#{@claude_waiting},working},1,}},…,}#{P:#{?#{&&:#{@claude_bg},#{!=:#{@claude_waiting},working}}, +#{@claude_bg},}}#{P:#{T:@claude_age}}#{?window_flags,#{window_flags}, }#[default]"
set -g window-status-current-format "#{?#{P:#{?#{==:#{@claude_waiting},input},1,}},#[fg=red]#[bold],}#I:#W#{?#{P:#{?#{==:#{@claude_waiting},working},1,}},…,}#{P:#{?#{&&:#{@claude_bg},#{!=:#{@claude_waiting},working}}, +#{@claude_bg},}}#{P:#{T:@claude_age}}#{?window_flags,#{window_flags}, }#[default]"
set-hook -g session-window-changed "run-shell -b \"~/.tmux/claude_hook.sh seen '#{window_id}'\""
set-hook -g client-session-changed "run-shell -b \"~/.tmux/claude_hook.sh seen '#{window_id}'\""
# prefix u marks the current pane unread, so its tab goes yellow once you leave
bind u run-shell -b "~/.tmux/claude_hook.sh unread '#{pane_id}'"
# tag sessions from session_tags whenever they are created or renamed
set-hook -g session-created "run-shell -b '~/.tmux/session_tags.sh'"
set-hook -g session-renamed "run-shell -b '~/.tmux/session_tags.sh'"
run-shell -b '~/.tmux/session_tags.sh'
# the session/window picker, with each session's tags before its window count.
# Otherwise tmux's default format.
set -g @tree_format '#{?pane_format,#{?pane_marked,#[reverse],}#{pane_current_command}#{?pane_active,*,}#{?pane_marked,M,}#{?#{&&:#{pane_title},#{!=:#{pane_title},#{host_short}}},: "#{pane_title}",},#{?window_format,#{?window_marked_flag,#[reverse],}#{window_name}#{window_flags}#{?#{&&:#{==:#{window_panes},1},#{&&:#{pane_title},#{!=:#{pane_title},#{host_short}}}},: "#{pane_title}",},#{?@tags,#[bold]#{@tags}#[default] ,}#{session_windows} windows#{?session_grouped, (group #{session_group}: #{session_group_list}),}#{?session_attached, (attached),}}}'
bind S choose-tree -Zs -F "#{E:@tree_format}"
bind w choose-tree -Zw -F "#{E:@tree_format}"
# prefix s: sessions grouped by tag in an fzf popup (see session_picker.sh),
# or the picker above when fzf isn't installed
bind s if-shell "command -v fzf > /dev/null" {
  run-shell -b "~/.tmux/session_picker.sh '#{client_name}'"
} {
  choose-tree -Zs -F "#{E:@tree_format}"
}
set-option -g pane-border-style fg=brightblue
set-option -g pane-active-border-style fg=red

# Old stopgap for OSX
# Fix for pbcopy, pbpaste, and launchctl
# set-option -g default-command "reattach-to-user-namespace -l zsh"

# tasks: a worktree + window running claude, see task.sh
#   prefix N   new task (prompts for a branch name)
#   prefix X   finish the task in the current pane's worktree
bind N command-prompt -p "task branch:" "run-shell \"cd '#{pane_current_path}' && ~/.tmux/task.sh new '%%'\""
bind X confirm-before -p "finish task (remove worktree, close window)? (y/n)" "run-shell \"cd '#{pane_current_path}' && ~/.tmux/task.sh done\""

# bindings for toggling pane sync
bind -n C-s setw synchronize-panes

set -g focus-events on

set -g default-terminal "tmux-256color"
set -g terminal-overrides ",xterm-256color:Tc"
