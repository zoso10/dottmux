# remap prefix to Ctrl+a
set -g prefix C-a
unbind C-b
bind C-a send-prefix

# force a reload of the config file
unbind r
bind r source-file ~/.tmux.conf

# quick pane cycling
unbind ^A
bind ^A select-pane -t :.+

# mouse actions
set -g mouse on
bind -n WheelUpPane if-shell -F -t = "#{mouse_any_flag}" "send-keys -M" "if -Ft= '#{pane_in_mode}' 'send-keys -M' 'copy-mode -e'"

# smart pane switching with awareness of vim
bind -n C-h run "(tmux display-message -p '#{pane_current_command}' | grep -iq vim && tmux send-keys C-h) || tmux select-pane -L"
bind -n C-j run "(tmux display-message -p '#{pane_current_command}' | grep -iq vim && tmux send-keys C-j) || tmux select-pane -D"
bind -n C-k run "(tmux display-message -p '#{pane_current_command}' | grep -iq vim && tmux send-keys C-k) || tmux select-pane -U"
bind -n C-l run "(tmux display-message -p '#{pane_current_command}' | grep -iq vim && tmux send-keys C-l) || tmux select-pane -R"

# Use vim keybindings
setw -g mode-keys vi

# Update default binding of 'Enter' to also use copy-pipe
unbind -T copy-mode-vi Enter
bind-key -T copy-mode-vi Enter send -X copy-pipe-and-cancel "xclip -in -selection clipboard"

# Up update frequency
set -g status-interval 5

# Theming
set -g status-style "bg=#103640"
# Set 24-hour clock
set-window-option -g clock-mode-style 24
set -g status-right-length 150
# The first segment is a script from ~/.tmux/scripts that is listed in
# ~/.tmux/approved_scripts. Pick a different one with
#   TMUX_STATUS_SCRIPT=claude_input tmux                (when starting the server)
#   tmux setenv -g TMUX_STATUS_SCRIPT claude_input      (while it is running)
set -g status-right "#(~/.tmux/status.sh claude_input) #[fg=red]::#[fg=brightblue] #[bold]%d#[nobold] %b #[fg=red]:: #[fg=brightblue]%k.%M "
# Window tabs show Claude state from claude_hook.sh: red when a Claude in the
# window is blocked on you, yellow when one finished and you haven't looked.
# Switching to a window marks it seen.
set -g window-status-format "#{?#{P:#{?#{==:#{@claude_waiting},input},1,}},#[fg=red]#[bold],#{?#{P:#{?#{==:#{@claude_waiting},done},1,}},#[fg=yellow],}}#I:#W#{?window_flags,#{window_flags}, }#[default]"
set -g window-status-current-format "#{?#{P:#{?#{==:#{@claude_waiting},input},1,}},#[fg=red]#[bold],}#I:#W#{?window_flags,#{window_flags}, }#[default]"
set-hook -g session-window-changed "run-shell -b \"~/.tmux/claude_hook.sh seen '#{window_id}'\""
set-hook -g client-session-changed "run-shell -b \"~/.tmux/claude_hook.sh seen '#{window_id}'\""
set-option -g pane-border-style fg=brightblue
set-option -g pane-active-border-style fg=red

# Old stopgap for OSX
# Fix for pbcopy, pbpaste, and launchctl
# set-option -g default-command "reattach-to-user-namespace -l zsh"

# tasks: a worktree + window running claude, see task.sh
#   prefix N   new task (prompts for a branch name)
#   prefix X   finish the task in the current pane's worktree
bind N command-prompt -p "task branch:" "run-shell \"cd '#{pane_current_path}' && ~/.tmux/task.sh new '%%'\""
bind X confirm-before -p "finish task (remove worktree, close window)? (y/n)" "run-shell \"cd '#{pane_current_path}' && ~/.tmux/task.sh done\""

# bindings for toggling pane sync
bind -n C-s setw synchronize-panes

set -g focus-events on
